{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bustub Docker Debug (concurrent test)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/bustub/build/test/b_plus_tree_contention_test",
      "args": ["--gtest_also_run_disabled_tests"],
      "cwd": "/bustub/build",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "bustub",
          "sh",
          "-c"
        ],
        "debuggerPath": "/usr/bin/gdb"
      },
      "sourceFileMap": {
        "/bustub": "${workspaceFolder}/project/database2022fall"
      },
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
